# 可选值: moonshot 或 openai
AI_PROVIDER=moonshot

# Moonshot (Kimi)
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_TEXT_MODEL=moonshot-v1-8k
MOONSHOT_VISION_MODEL=moonshot-v1-128k-vision-preview
AI_PROVIDER_TIMEOUT_MS=85000

